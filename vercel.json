{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/.well-known/apple-developer-merchantid-domain-association", "destination": "/.well-known/apple-developer-merchantid-domain-association" },
    { "source": "/industries/:slug", "destination": "/industries/:slug.html" },
    { "source": "/favicon.ico", "destination": "/public/favicon.ico" },
    { "source": "/favicon-32x32.png", "destination": "/public/favicon-32x32.png" },
    { "source": "/favicon-16x16.png", "destination": "/public/favicon-16x16.png" },
    { "source": "/apple-touch-icon.png", "destination": "/public/apple-touch-icon.png" },
    { "source": "/site.webmanifest", "destination": "/public/site.webmanifest" }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true }
  ]
}
