<!DOCTYPE html>
<html lang="en"><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>LeadsPitch - Buy Verified B2B Lead Data by Niche | CSV Datasets</title>
  <meta name="description" content="Buy verified B2B leads and niche-specific business data as ready-to-use CSV datasets. Emails, phones, and websites across 19+ niches. One flat price, no credits, no software.">
  <meta property="og:title" content="LeadsPitch, Verified B2B Business Data by Niche">
  <meta property="og:description" content="Buy verified B2B leads and niche-specific business data as ready-to-use CSV datasets. One flat price, no credits, no software.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://leadspitch.com/">
  <meta property="og:site_name" content="LeadsPitch">
  <meta property="og:image" content="https://leadspitch.com/public/sample-excel.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="LeadsPitch, Verified B2B Business Data by Niche">
  <meta name="twitter:description" content="Buy verified B2B leads and niche-specific business data as ready-to-use CSV datasets. No credits, no software.">
  <meta name="twitter:image" content="https://leadspitch.com/public/sample-excel.png">
  <link rel="canonical" href="https://leadspitch.com/">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "LeadsPitch",
    "url": "https://leadspitch.com",
    "logo": "https://leadspitch.com/public/leadspitch logo.png",
    "description": "Business data platform offering verified B2B lead datasets as CSV files. One-time purchases and monthly subscriptions across 19+ industries.",
    "foundingDate": "2024",
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer service",
      "url": "https://leadspitch.com/contact.html"
    }
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "LeadsPitch",
    "url": "https://leadspitch.com",
    "description": "Buy verified B2B leads and industry-specific business data as ready-to-use CSV datasets."
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is LeadsPitch?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "LeadsPitch delivers verified B2B leads as CSV datasets across 19+ niches. Subscribe monthly or buy one-time. Each file includes business names, emails, phone numbers, websites, locations, ratings, and more."
        }
      },
      {
        "@type": "Question",
        "name": "How is LeadsPitch different from Apollo or ZoomInfo?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Apollo and ZoomInfo are searchable software platforms with credit systems. LeadsPitch delivers finished CSV datasets with no software, no credits, and no dashboard to learn."
        }
      },
      {
        "@type": "Question",
        "name": "Is LeadsPitch data verified?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Every dataset is sourced and verified before delivery. Where a field can't be confirmed, it's left blank rather than filled with unverified data."
        }
      },
      {
        "@type": "Question",
        "name": "How much does LeadsPitch cost?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Prices vary by niche and dataset size. One-time datasets start at a flat rate. Monthly plans include a discount and fresh data delivered automatically."
        }
      },
      {
        "@type": "Question",
        "name": "What data fields are included?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Each CSV typically includes business name, email, phone, website, address, city, state, rating, review count, and more depending on the niche."
        }
      },
      {
        "@type": "Question",
        "name": "How often is the data updated?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Every dataset is built from scratch at the time of purchase or subscription renewal. You always get fresh, current data."
        }
      },
      {
        "@type": "Question",
        "name": "Can I request a custom niche?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. If your niche isn't listed, contact us and we'll build a custom dataset for your specific market."
        }
      }
    ]
  }
  </script>
  <style>
    :root {
      --bg: #ffffff;
      --bg-soft: #f6f6f7;
      --surface: #ffffff;
      --surface-2: #f0f0f2;
      --ink: #0b0b0d;
      --muted: #55565b;
      --faint: #8a8b91;
      --line: #e5e5e8;
      --line-strong: #d0d0d5;

      --font: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --text-xs: 0.75rem;
      --text-sm: 0.875rem;
      --text-base: 1rem;
      --text-lg: 1.125rem;

      --gap-xs: 0.5rem;
      --gap-sm: 0.75rem;
      --gap: 1rem;
      --gap-lg: 1.5rem;
      --gap-xl: clamp(2rem, 5vw, 3.5rem);
      --section: clamp(3.5rem, 8vw, 6rem);

      --radius-lg: 18px;
      --radius-md: 14px;
      --radius-sm: 10px;
      --shadow-card: 0 1px 2px rgba(20, 20, 28, 0.04), 0 12px 32px -20px rgba(20, 20, 28, 0.10);
      --shadow-lift: 0 2px 4px rgba(20, 20, 28, 0.05), 0 20px 44px -20px rgba(20, 20, 28, 0.16);
      --shadow-menu: 0 4px 12px rgba(20, 20, 28, 0.06), 0 24px 56px -20px rgba(20, 20, 28, 0.18);

      --max: 1120px;
      --gutter: clamp(1.25rem, 4vw, 2rem);
      --nav-h: 72px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; scroll-padding-top: calc(var(--nav-h) + 0.75rem); }
    body {
      font-family: var(--font);
      font-size: var(--text-base);
      line-height: 1.6;
      color: var(--ink);
      background: var(--bg);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    img, svg { display: block; max-width: 100%; }
    a { color: inherit; text-decoration: none; }
    button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
    ul { list-style: none; }
    :focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

    .wrap { width: min(100% - var(--gutter) * 2, var(--max)); margin-inline: auto; }

    h1.display {
      font-size: clamp(2.75rem, 7vw, 4.5rem);
      font-weight: 700;
      letter-spacing: -0.04em;
      line-height: 1.05;
      color: var(--ink);
      margin: 0 auto 1.25rem;
      max-width: 16ch;
      text-align: center;
      text-wrap: balance;
    }
    .lede {
      font-size: var(--text-lg);
      color: var(--muted);
      line-height: 1.65;
      max-width: 34rem;
      margin-inline: auto;
      text-align: center;
      text-wrap: pretty;
    }
    .section-head {
      display: grid;
      gap: 0.65rem;
      margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
      max-width: 40rem;
      margin-inline: auto;
      text-align: center;
    }
    .section-head h2 {
      font-size: clamp(2.25rem, 4.5vw, 3rem);
      font-weight: 700;
      letter-spacing: -0.04em;
      line-height: 1.05;
      text-wrap: balance;
    }
    .section-head .lede { font-size: var(--text-base); margin-top: 0.25rem; margin-inline: unset; }
    .muted { color: var(--muted); }
    .text-fade { color: var(--muted); }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      min-height: 46px;
      padding: 0.65rem 1.35rem;
      border-radius: 999px;
      font-size: var(--text-sm);
      font-weight: 600;
      letter-spacing: 0.01em;
      transition: background 180ms ease, color 180ms ease, border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
    }
    .btn:active { transform: translateY(1px); }
    .btn-primary { background: var(--ink); color: #fff; box-shadow: 0 1px 2px rgba(20,20,28,0.2); }
    .btn-primary:hover { background: #26262b; box-shadow: 0 8px 20px -8px rgba(20,20,28,0.35); }
    .btn-ghost { border: 1px solid var(--line-strong); color: var(--ink); background: var(--surface); }
    .btn-ghost:hover { border-color: var(--faint); background: var(--bg-soft); }
    .link-inline { color: var(--ink); text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 0.18em; transition: text-decoration-color 160ms ease; }
    .link-inline:hover { text-decoration-color: var(--ink); }

    /* Nav */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 50;
      height: var(--nav-h);
      background: transparent;
      transition: background 200ms ease, box-shadow 200ms ease;
    }
    .site-header.is-scrolled {
      background: rgba(255, 255, 255, 0.86);
      -webkit-backdrop-filter: blur(18px);
      backdrop-filter: blur(18px);
      box-shadow: 0 1px 0 var(--line);
    }
    .nav {
      height: var(--nav-h);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      position: relative;
    }
    .logo { display: inline-flex; align-items: center; gap: 0.65rem; font-weight: 600; letter-spacing: -0.02em; font-size: 1.05rem; flex-shrink: 0; }
    .logo img { height: 34px; width: auto; }

    .nav-pill {
      display: none;
      align-items: center;
      gap: 0.125rem;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 0.375rem 0.5rem;
      box-shadow: var(--shadow-card);
    }
    .nav-pill a,
    .nav-pill .nav-dropdown-toggle {
      font-size: var(--text-xs);
      font-weight: 500;
      color: var(--muted);
      padding: 0.5rem 0.875rem;
      border-radius: 999px;
      white-space: nowrap;
      transition: color 180ms ease, background 180ms ease;
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
    }
    .nav-pill a:hover,
    .nav-pill .nav-dropdown-toggle:hover { color: var(--ink); background: var(--surface-2); }
    .nav-pill a.active { color: var(--ink); background: var(--surface-2); font-weight: 600; }
    .nav-pill .logo { font-size: 0.9375rem; padding: 0.375rem 0.75rem; border-radius: 999px; color: var(--ink); }
    .nav-pill .logo:hover { background: var(--surface-2); }
    .nav-pill .logo img { height: 30px; }

    .nav-dropdown { position: relative; }
    .nav-dropdown-toggle { background: none; border: none; cursor: pointer; font: inherit; }
    .nav-dropdown-toggle svg { width: 10px; height: 10px; transition: transform 250ms cubic-bezier(0.34, 1.56, 0.64, 1); }
    .nav-dropdown-toggle[aria-expanded="true"] svg { transform: rotate(180deg); }

    .nav-dropdown-menu {
      position: absolute;
      top: calc(100% + 12px);
      left: 50%;
      width: 460px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-menu);
      padding: 0.5rem;
      z-index: 100;
      opacity: 0;
      transform: translateX(-50%) scale(0.94) translateY(-8px);
      transform-origin: top center;
      pointer-events: none;
      transition: opacity 220ms cubic-bezier(0.34, 1.56, 0.64, 1), transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1);
      display: grid;
      grid-template-columns: repeat(3, 1fr);
    }
    .nav-dropdown.open .nav-dropdown-menu { opacity: 1; transform: translateX(-50%) scale(1) translateY(0); pointer-events: auto; }
    .nav-dropdown-menu a {
      display: flex;
      align-items: center;
      padding: 0.575rem 0.75rem;
      font-size: var(--text-xs);
      font-weight: 500;
      color: var(--muted);
      border-radius: var(--radius-sm);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      transition: color 160ms ease, background 160ms ease;
    }
    .nav-dropdown-menu a:hover { color: var(--ink); background: var(--surface-2); }

    .nav-right { display: flex; align-items: center; gap: 0.5rem; margin-left: auto; }

    .nav-toggle {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: var(--surface);
      transition: background 150ms ease;
    }
    .nav-toggle:hover { background: var(--surface-2); }
    .nav-toggle span { display: block; width: 16px; height: 1.5px; background: var(--ink); position: relative; }
    .nav-toggle span::before,
    .nav-toggle span::after {
      content: "";
      position: absolute; left: 0; width: 100%; height: 1.5px;
      background: var(--ink);
      transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1), opacity 180ms ease;
    }
    .nav-toggle span::before { top: -5px; }
    .nav-toggle span::after { top: 5px; }
    .nav-toggle[aria-expanded="true"] span { background: transparent; }
    .nav-toggle[aria-expanded="true"] span::before { top: 0; transform: rotate(45deg); }
    .nav-toggle[aria-expanded="true"] span::after { top: 0; transform: rotate(-45deg); }

    .mobile-panel {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 100;
      background: var(--bg);
      flex-direction: column;
      justify-content: center;
      padding: 5rem var(--gutter) 3rem;
    }
    .mobile-panel.open { display: flex; }
    .mobile-panel .mobile-nav-links { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 0; width: 100%; max-width: 320px; }
    .mobile-panel .mobile-nav-links a {
      display: flex; align-items: center; gap: 0.75rem; padding: 1.05rem 0;
      font-size: 1.4rem; font-weight: 500; letter-spacing: -0.02em;
      color: var(--muted); border-bottom: 1px solid var(--line); width: 100%;
      transition: color 200ms ease, padding-left 200ms ease;
    }
    .mobile-panel .mobile-nav-links a:hover, .mobile-panel .mobile-nav-links a:active { color: var(--ink); padding-left: 0.75rem; }
    .mobile-dropdown-toggle {
      display: flex; align-items: center; gap: 0.5rem; padding: 1.05rem 0;
      font-size: 1.4rem; font-weight: 500; letter-spacing: -0.02em; color: var(--muted);
      border: none; background: none; cursor: pointer; width: 100%; text-align: left;
      border-bottom: 1px solid var(--line);
      transition: color 200ms ease, padding-left 200ms ease;
    }
    .mobile-dropdown-toggle svg { width: 16px; height: 16px; transition: transform 250ms cubic-bezier(0.34, 1.56, 0.64, 1); }
    .mobile-dropdown-toggle[aria-expanded="true"] svg { transform: rotate(180deg); }
    .mobile-dropdown-toggle:hover { color: var(--ink); padding-left: 0.75rem; }
    .mobile-dropdown-panel { display: none; flex-direction: column; padding-left: 1rem; max-height: 0; overflow: hidden; opacity: 0; transition: max-height 350ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 250ms ease; }
    .mobile-dropdown-panel.open { display: flex; max-height: 720px; opacity: 1; }
    .mobile-dropdown-panel a { display: flex; align-items: center; padding: 0.65rem 0; font-size: 1.05rem; font-weight: 400; color: var(--faint); border-bottom: 1px solid var(--line); transition: color 200ms ease, padding-left 200ms ease; }
    .mobile-dropdown-panel a:hover { color: var(--ink); padding-left: 0.5rem; }
    .mobile-panel .mobile-nav-cta { position: relative; z-index: 1; margin-top: 2rem; width: 100%; max-width: 320px; }
    .mobile-panel .mobile-nav-cta .btn { width: 100%; background: var(--ink); color: #fff; border: none; }
    .mobile-close {
      position: absolute; top: 1.25rem; right: var(--gutter); z-index: 2;
      width: 44px; height: 44px; display: grid; place-items: center;
      border: 1px solid var(--line); border-radius: 999px; background: var(--surface); color: var(--ink);
    }
    .mobile-close:hover { background: var(--surface-2); }
    .mobile-close svg { width: 18px; height: 18px; }

    @media (min-width: 900px) {
      .nav-pill { display: inline-flex; }
      .nav-right { display: none !important; }
      .mobile-panel { display: none !important; }
    }

    /* Hero */
    .hero {
      position: relative;
      padding: clamp(3.5rem, 8vw, 7rem) 0 clamp(2.5rem, 5vw, 4rem);
      text-align: center;
    }
    .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; margin-top: 1.75rem; }
    .hero-meta { margin-top: 1.5rem; font-size: var(--text-xs); color: var(--faint); letter-spacing: 0.02em; text-align: center; }
    .field-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; justify-content: center; margin-top: 1rem; }
    .chip {
      font-size: var(--text-xs);
      font-weight: 500;
      color: var(--muted);
      padding: 0.3rem 0.7rem;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: var(--surface);
    }

    /* Sections */
    section { padding: var(--section) 0; }
    .band { background: var(--bg-soft); }

    /* Steps */
    .steps { display: grid; gap: var(--gap); }
    @media (min-width: 860px) { .steps { grid-template-columns: repeat(3, 1fr); } }
    .step {
      position: relative;
      padding: 1.75rem 1.5rem;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      background: var(--surface);
      box-shadow: var(--shadow-card);
    }
    .step-index {
      font-size: var(--text-xs);
      font-weight: 600;
      letter-spacing: 0.1em;
      color: var(--faint);
      margin-bottom: 1rem;
      display: block;
    }
    .step h3 { font-size: 1.05rem; font-weight: 600; letter-spacing: -0.01em; margin-bottom: 0.4rem; }
    .step p { color: var(--muted); font-size: var(--text-sm); line-height: 1.6; }

    /* Niches - market index grid */
    .niche-grid {
      display: grid;
      gap: clamp(0.75rem, 1.4vw, 1rem);
      grid-template-columns: repeat(12, 1fr);
      grid-auto-rows: auto;
      margin-top: clamp(1.5rem, 3vw, 2.25rem);
    }
    .niche-card {
      position: relative;
      grid-column: span 3;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      padding: clamp(1rem, 1.5vw, 1.25rem);
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      background: var(--surface);
      text-decoration: none;
      overflow: hidden;
      transition: border-color 200ms ease, box-shadow 200ms ease, transform 200ms ease;
    }
    .niche-card::before {
      content: "";
      position: absolute; inset: 0 0 auto 0; height: 2px;
      background: linear-gradient(90deg, var(--ink), transparent);
      opacity: 0;
      transition: opacity 200ms ease;
      pointer-events: none;
    }
    .niche-card:hover {
      border-color: var(--line-strong);
      box-shadow: var(--shadow-card);
      transform: translateY(-2px);
    }
    .niche-card:hover::before { opacity: 1; }
    .niche-card--featured {
      grid-column: span 6;
      order: -1;
      border-color: var(--ink);
      background: var(--bg);
    }
    .niche-card--featured::before { opacity: 1; }
    .niche-card--featured .niche-card__name { font-size: clamp(1.05rem, 1.6vw, 1.4rem); }
    .niche-card--featured .niche-card__num { font-size: clamp(1.6rem, 3vw, 2.15rem); }
    .niche-card--featured .niche-card__cap { font-size: var(--text-sm); }

    .niche-card__head {
      display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
    }
    .niche-card__name {
      font-size: 0.95rem; font-weight: 600; letter-spacing: -0.01em;
      color: var(--ink); line-height: 1.3;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .niche-card__arrow {
      width: 26px; height: 26px; border-radius: 50%;
      border: 1px solid var(--line);
      display: grid; place-items: center;
      color: var(--muted); flex-shrink: 0;
      transition: color 160ms ease, border-color 160ms ease, transform 200ms cubic-bezier(0.22,1,0.36,1);
    }
    .niche-card:hover .niche-card__arrow {
      color: var(--ink); border-color: var(--line-strong); transform: translateX(2px);
    }
    .niche-card__arrow svg { width: 11px; height: 11px; }
    .niche-card__numrow {
      display: flex; align-items: baseline; gap: 0.5rem; flex-wrap: wrap;
    }
    .niche-card__num {
      font-size: clamp(1.3rem, 2.2vw, 1.6rem);
      font-weight: 700; letter-spacing: -0.03em;
      color: var(--ink); line-height: 1;
      font-variant-numeric: tabular-nums;
    }
    .niche-card__cap { font-size: var(--text-xs); color: var(--faint); font-weight: 500; }
    .niche-card__hbar {
      position: relative; height: 5px; border-radius: 99px;
      background: var(--bg-soft); overflow: hidden;
    }
    .niche-card__hbar-fill {
      display: block; height: 100%; width: 0;
      background: linear-gradient(90deg, var(--ink) 0%, #56565f 100%);
      border-radius: 99px;
      transition: width 900ms cubic-bezier(0.22,1,0.36,1);
    }
    .niche-card.is-in-view .niche-card__hbar-fill { width: var(--w); }
    .niche-card__foot {
      display: flex; align-items: center; gap: 0.5rem;
      font-size: 0.78rem; font-weight: 500; color: var(--faint);
      border-top: 1px solid var(--line);
      padding-top: 0.75rem;
      margin-top: auto;
      white-space: nowrap; overflow: hidden;
    }
    .niche-card__foot .niche-card__emails { color: var(--ink); font-weight: 600; }
    .niche-card__dot { color: var(--line-strong); flex-shrink: 0; }
    .niches-note {
      margin-top: var(--gap-lg); font-size: var(--text-sm); color: var(--faint); text-align: center;
    }
    @media (max-width: 1100px) {
      .niche-grid { grid-template-columns: repeat(8, 1fr); }
      .niche-card { grid-column: span 2; }
      .niche-card--featured { grid-column: span 4; }
    }
    @media (max-width: 700px) {
      .niche-grid { grid-template-columns: repeat(2, 1fr); }
      .niche-card { grid-column: span 1; }
      .niche-card--featured { grid-column: span 2; }
    }
    @media (max-width: 400px) {
      .niche-grid { grid-template-columns: 1fr; }
      .niche-card { grid-column: span 1; }
      .niche-card--featured { grid-column: span 1; }
    }
    @media (prefers-reduced-motion: reduce) {
      .niche-card.is-in-view .niche-card__hbar-fill { width: var(--w); transition: none; }
    }

    /* Pricing */
    .pricing-grid { display: grid; gap: var(--gap); }
    @media (min-width: 700px) { .pricing-grid { grid-template-columns: repeat(2, 1fr); } }
    .pricing-card {
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      background: var(--surface);
      padding: 2rem 1.75rem;
      display: grid;
      gap: 0.75rem;
      box-shadow: var(--shadow-card);
      transition: transform 200ms ease, box-shadow 200ms ease;
    }
    .pricing-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-lift); }
    .pricing-card--featured { border-color: var(--ink); }
    .pricing-card__name { font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--faint); display: flex; align-items: center; gap: 0.5rem; }
    .pricing-card__price { font-size: clamp(1.75rem, 3vw, 2.25rem); font-weight: 700; letter-spacing: -0.03em; color: var(--ink); }
    .pricing-card__price span { font-size: var(--text-sm); font-weight: 400; color: var(--muted); }
    .pricing-card__desc { color: var(--muted); font-size: var(--text-sm); line-height: 1.55; }
    .pricing-card .btn { margin-top: 0.75rem; width: 100%; }
    .member-perk { display: inline-flex; align-items: center; padding: 0.2rem 0.6rem; border-radius: 999px; background: var(--surface-2); color: var(--ink); font-size: 11px; font-weight: 600; }

    /* FAQ - Subframe style */
    .faq-section { max-width: 720px; margin-inline: auto; }
    .faq-heading {
      font-size: clamp(3.5rem, 8vw, 6rem);
      font-weight: 700;
      letter-spacing: -0.04em;
      line-height: 1;
      color: var(--ink);
      margin-bottom: 0.5rem;
    }
    .faq-subtitle {
      font-size: clamp(1.1rem, 2.5vw, 1.5rem);
      font-weight: 400;
      font-style: italic;
      color: var(--faint);
      margin-bottom: clamp(2rem, 5vw, 3.5rem);
    }
    .faq-list { display: grid; gap: 0.5rem; }
    .faq-item {
      border-radius: var(--radius-md);
      background: var(--bg-soft);
      overflow: hidden;
      transition: background 200ms ease;
    }
    .faq-item:hover { background: #ededf0; }
    .faq-item.open { background: #ededf0; }
    .faq-q {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      text-align: left;
      padding: 1.25rem 1.5rem;
      font-size: clamp(0.95rem, 2vw, 1.1rem);
      font-weight: 500;
      letter-spacing: -0.01em;
      color: var(--ink);
    }
    .faq-q svg {
      width: 20px; height: 20px;
      color: var(--faint);
      flex: 0 0 auto;
      transition: transform 250ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .faq-item.open .faq-q svg { transform: rotate(180deg); }
    .faq-a { max-height: 0; overflow: hidden; transition: max-height 320ms cubic-bezier(0.22, 1, 0.36, 1); }
    .faq-item.open .faq-a { max-height: 300px; }
    .faq-a-text {
      padding: 0 1.5rem 1.25rem;
      color: var(--muted);
      font-size: var(--text-sm);
      line-height: 1.65;
      max-width: 62ch;
    }
    .faq-more { margin-top: var(--gap-lg); font-size: var(--text-sm); color: var(--faint); text-align: center; }

    /* Gevora Font */
    @font-face { font-family: "Gevora"; src: url("public/Gevora font.ttf") format("truetype"); font-weight: 400; font-style: normal; font-display: swap; }

    /* Final CTA */
    .final-cta-wrap { text-align: center; max-width: 40rem; margin-inline: auto; }
    .final-cta-title { font-size: clamp(2.1rem, 4.5vw, 3.2rem); margin: 0 0 1rem; }
    .final-cta-lede { margin-inline: auto; }
    .final-cta-actions { justify-content: center; margin-top: 1.75rem; }

    /* Footer */
    .site-footer { background: var(--ink); color: #b7b7bd; padding: clamp(2.5rem, 5vw, 4rem) 0 0; margin-top: 1rem; }
    .footer-top { display: grid; gap: 2rem; padding-bottom: clamp(2rem, 4vw, 3rem); border-bottom: 1px solid #26262b; }
    .footer-brand { max-width: 26ch; }
    .footer-brand .logo { color: #fff; margin-bottom: 0.9rem; }
    .footer-brand p { color: #85858c; font-size: var(--text-sm); line-height: 1.55; }
    .footer-grid { display: grid; gap: 2rem; grid-template-columns: repeat(2, 1fr); }
    @media (min-width: 700px) { .footer-grid { grid-template-columns: repeat(4, 1fr); } }
    .footer-col h4 { font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #6f6f76; margin-bottom: 0.9rem; }
    .footer-col a { display: block; color: #9a9aa1; font-size: var(--text-sm); padding: 0.25rem 0; transition: color 150ms ease; }
    .footer-col a:hover { color: #fff; }
    .footer-bottom { margin-top: 2rem; padding: 1.25rem 0; border-top: 1px solid #26262b; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; justify-content: space-between; color: #6f6f76; font-size: var(--text-xs); }
    .footer-giant { width: 100%; padding-top: clamp(0.75rem, 2vw, 2rem); text-align: center; }
    .footer-giant__text { font-family: "Gevora", "Arial Black", Impact, sans-serif; font-size: clamp(2rem, 7.5vw, 12rem); line-height: 0.85; letter-spacing: 0.01em; white-space: nowrap; color: #fff; user-select: none; }

    /* Reveal on scroll */
    .reveal { opacity: 0; transform: translateY(16px); transition: opacity 600ms ease, transform 600ms cubic-bezier(0.22, 1, 0.36, 1); }
    .reveal.is-visible { opacity: 1; transform: none; }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; scroll-behavior: auto !important; }
      .reveal { opacity: 1; transform: none; }
      .niche { opacity: 1; transform: none; }
    }
  </style>
</head>
